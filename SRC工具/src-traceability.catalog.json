    "approvalMetadataChangePolicy": "revoke-and-reapprove",
    "directPrintBoundary": true,
    "optionalProjectMetadata": true,
    "publicRoute": true,
    "route": "/src-beam",
    "releaseStatus": "formal-release-ready"
  },
  "equations": [
    { "id": "src-5.4-1", "clause": "5.4.1", "expression": "phi_b Mn = 0.9 Mns + 0.9 Mnrc", "implementation": "calculate.flexure" },
    { "id": "src-mns", "clause": "5.4.1", "expression": "Mns = Z Fys", "implementation": "calculate.flexure.mnSteelTfM" },
    { "id": "src-5.5-1", "clause": "5.5", "expression": "0.9 Vns >= (Mns/Mn) Vu", "implementation": "calculate.shear.steelUtilization" },
    { "id": "src-5.5-2", "clause": "5.5", "expression": "0.75 Vnrc >= (Mnrc/Mn) Vu", "implementation": "calculate.shear.rcUtilization" },
    { "id": "src-5.5-3", "clause": "5.5.1", "expression": "Vns = 0.6 Fyw Aw", "implementation": "calculate.shear.vnSteelTf" },
    { "id": "src-5.5-4", "clause": "5.5.2", "expression": "Vnrc,general = min(Av Fyh d/s, 2.12 sqrt(fc') b d) + 0.53 sqrt(fc') b d", "implementation": "calculate.shear.vnRcGeneralTf" },
    { "id": "src-5.5-10", "clause": "5.5.2", "expression": "Vnrc,friction = min(mu Avf Fyh d/s, 2.12 mu sqrt(fc') b d) + K1 b' d + Vns'", "implementation": "calculate.shear.vnRcFrictionTf" },
    { "id": "src-3.4", "clause": "3.4 / Table 3.4-1", "expression": "encased H-shape flange and web width-thickness limits", "implementation": "calculateCompactness" }
  ],

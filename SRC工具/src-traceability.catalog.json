  "regulation": {
    "title": "鋼骨鋼筋混凝土構造設計規範與解說",
    "versionLabel": "100 年修正版（100 年 7 月 1 日施行）",
    "officialPage": "https://www.nlma.gov.tw/ch/legislation/regsearch/977",
    "draftBoundary": "2024 年內政部建築研究所成果為修正草案，本核心不將草案當作現行法規。"
  },
  "scope": {
    "included": [
      "完全包覆型矩形 SRC 梁",
      "置中雙對稱 H 型鋼骨",
      "無軸力之撓曲與剪力",
      "垂直箍筋",
      "常重混凝土整體澆置",
      "非耐震構材強度檢核"
    ],
    "excluded": [
      "第 9 章耐震設計",
      "軸力與彎矩互制",
      "梁柱接頭與續接",
      "剪力釘強度",
      "輕質混凝土或非整體澆置剪力摩擦面",
      "施工階段鋼梁強度與穩定實算"
    ]
  },

    { "route": "/wind-force", "priority": "P0", "evidenceNeeded": "規範例題或逐項手算之風力基準" },
    { "route": "/seismic-force", "priority": "P0", "evidenceNeeded": "規範例題或逐項手算之地震力基準" },

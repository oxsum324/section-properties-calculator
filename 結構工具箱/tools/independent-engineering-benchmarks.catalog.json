        "dynamicFactor": 1.1,
        "supportCount": 4,
        "contactB": 0.25,
        "contactL": 0.25,
        "spreadDepth": 0.15,
        "planB": 2.4,
        "planL": 1.2,
        "allowableContact": 100,
        "allowableSpread": 20,
        "allowablePoint": 5,
        "horizontalCoeff": 0.2
